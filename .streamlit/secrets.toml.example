# Copy to .streamlit/secrets.toml (gitignored) for local runs, or paste into
# Streamlit Community Cloud > App settings > Secrets. Values here override .env.

# Backend API (POST {BACKEND_API_URL}/api/query). Base URL only, no trailing path.
# arxivchron > Overview > Default domain
BACKEND_API_URL = "https://your-function-app.azurewebsites.net"
# arxivchron > Functions > App keys > default
BACKEND_API_KEY = "your-function-key-here"

# Only needed while the app still runs the pipeline in-process (current demo).
# GEMINI_API_KEY = "your-gemini-api-key-here"
# GEMINI_MODEL = "gemini-3.5-flash-lite"
