# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Embedding model used by the current local pipeline (768 dimensions)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Chroma local persistence
CHROMA_DB_PATH=./chroma_db

COLLECTION_NAME=kpmg_papers

# --- Cloud resources (for moving the pipeline to Azure + Pinecone) ---

# Azure OpenAI; the cloud pipeline embeds with the text-embedding-3-small deployment (1536 dimensions)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_KEY=your-azure-openai-key-here

# Pinecone vector DB (arxiv-papers is 1536-dim, cosine, to match text-embedding-3-small)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=arxiv-papers

# Azure Blob Storage for arXiv PDFs; same value as the function app's DEPLOYMENT_STORAGE_CONNECTION_STRING
# (arxivpdfs > Access keys > Connection string)
DEPLOYMENT_STORAGE_CONNECTION_STRING=your-storage-connection-string
PDF_CONTAINER=pdfs
